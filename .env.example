# Chave de API Groq (Llama 3.3 70B)
# Obtenha gratuitamente em https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Modelo Groq 
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de Embeddings Local FastEmbed
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Diretórios de Persistência
CHROMA_PERSIST_DIR=./chroma_db
DATA_FILES_DIR=./data_files

# Parâmetros de Recuperação (RAG)
TOP_K=4
# recomendo usar 0.0 para respostas mais diretas
TEMPERATURE=0.2

#  Parâmetros de Chunking (Divisão de Texto) 
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
